---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  xmlns="http://www.w3.org/2000/svg"
>
  <path d="M4 20v-6" />
  <path d="M10 20V8" />
  <path d="M16 20v-9" />
  <path d="M2 20h20" />
</svg>
