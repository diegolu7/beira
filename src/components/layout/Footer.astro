---
import { site, nav, services } from '../../data/site';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <img
          src={import.meta.env.BASE_URL + 'icon-beira-white.webp'}
          alt="Beira"
          width="105"
          height="30"
          class="footer__logo"
          loading="lazy"
        />
        <p class="footer__tag">
          Consultora tecnológica B2B: software a medida, productos digitales, e-commerce y
          consultoría IT.
        </p>
      </div>

      <nav class="footer__col" aria-label="Navegación del sitio">
        <p class="footer__heading">Navegación</p>
        <ul class="footer__list">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="footer__link">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer__col">
        <p class="footer__heading">Servicios</p>
        <ul class="footer__list">
          {services.map((service) => (
            <li>
              <a href="#servicios" class="footer__link">{service.title}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer__col">
        <p class="footer__heading">Contacto</p>
        <ul class="footer__list">
          <li>
            <a href="mailto:{site.contact.email}" class="footer__link">{site.contact.email}</a>
          </li>
          <li>
            <WhatsAppButton
              variant="primary"
              size="md"
              location="footer"
              label="Consultar por WhatsApp"
            />
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {new Date().getFullYear()} Beira.ar. Todos los derechos reservados.</p>
      <p>Salta, Argentina.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ink);
    color: var(--color-on-dark);
    padding-block: var(--space-9) var(--space-6);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-footer-border);
  }

  .footer__logo {
    width: 105px;
    height: auto;
  }

  .footer__tag {
    margin-top: var(--space-4);
    max-width: 300px;
    color: var(--color-footer-text);
    font-size: var(--text-sm);
  }

  .footer__heading {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-on-dark);
    margin-bottom: var(--space-4);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .footer__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-footer-link);
    text-decoration: none;
    font-size: var(--text-sm);
    min-height: 44px;
    transition: color var(--transition);
  }

  .footer__link:hover {
    color: var(--color-accent-deep);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
  }

  .footer__bottom p {
    color: var(--color-footer-text);
    font-size: var(--text-xs);
  }

  @media (max-width: 1023px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }

    .footer__bottom {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
