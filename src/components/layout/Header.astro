---
import { nav, site } from '../../data/site';
import { getWhatsAppUrl } from '../../utils/whatsapp';
import WhatsAppIcon from '../icons/WhatsAppIcon.astro';
import MenuIcon from '../icons/MenuIcon.astro';
import CloseIcon from '../icons/CloseIcon.astro';
---

<header class="header">
  <div class="container header__inner">
    <a href="#top" class="header__brand" aria-label="Beira — inicio">
      <img
        src={import.meta.env.BASE_URL + 'icon-beira-white.webp'}
        alt="Beira"
        width="105"
        height="30"
        class="header__logo"
        fetchpriority="high"
      />
    </a>

    <nav id="primary-nav" class="header__nav" aria-label="Navegación principal">
      <ul class="header__links">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="header__link">{item.label}</a>
            </li>
          ))
        }
      </ul>
      <a
        href={getWhatsAppUrl(site.whatsappMessage)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--primary header__cta"
        data-analytics="whatsapp"
        data-location="header"
      >
        <WhatsAppIcon class="btn__icon" />
        <span>WhatsApp</span>
      </a>
    </nav>

    <button
      type="button"
      class="header__toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Abrir menú de navegación"
    >
      <MenuIcon class="header__toggle-open" />
      <CloseIcon class="header__toggle-close" />
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.header');
  const toggle = header?.querySelector<HTMLButtonElement>('.header__toggle');
  const nav = header?.querySelector<HTMLElement>('.header__nav');
  const focusables = nav?.querySelectorAll<HTMLAnchorElement>('a') ?? [];

  let open = false;

  const setOpen = (value: boolean): void => {
    open = value;
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
    header?.classList.toggle('is-open', open);
    document.body.classList.toggle('nav-open', open);
    if (open && focusables.length > 0) {
      focusables[0].focus();
    }
  };

  toggle?.addEventListener('click', () => setOpen(!open));

  document.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape' && open) {
      setOpen(false);
      toggle?.focus();
    }
  });

  focusables.forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 900 && open) {
      setOpen(false);
    }
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-ink);
    border-bottom: 1px solid var(--color-ink-2);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    height: var(--header-height);
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .header__logo {
    width: 105px;
    height: auto;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .header__links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
  }

  .header__link {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-on-dark);
    text-decoration: none;
    padding: 0.5rem 0;
    position: relative;
    transition: opacity var(--transition);
  }

  .header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 2px;
    background: var(--color-accent);
    transition: right var(--transition);
  }

  .header__link:hover {
    opacity: 0.7;
  }

  .header__link:hover::after {
    right: 0;
  }

  .header__toggle {
    display: none;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-icon);
    color: var(--color-on-dark);
  }

  .header__toggle:hover {
    background: var(--color-ink-2);
  }

  .header__toggle svg {
    width: 24px;
    height: 24px;
  }

  :global(.header__toggle-close) {
    display: none;
  }

  :global(.header.is-open .header__toggle-open) {
    display: none;
  }

  :global(.header.is-open .header__toggle-close) {
    display: block;
  }

  @media (max-width: 899px) {
    .header__toggle {
      display: grid;
      place-items: center;
    }

    .header__nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--color-ink);
      border-bottom: 1px solid var(--color-ink-2);
      padding: var(--space-3) clamp(1.25rem, 5vw, 4rem) var(--space-6);
      box-shadow: var(--shadow-float);
    }

    .header.is-open .header__nav {
      display: flex;
    }

    .header__links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .header__link {
      display: block;
      padding: 1rem 0;
      font-size: var(--text-base);
      border-bottom: 1px solid var(--color-ink-2);
    }

    .header__link::after {
      display: none;
    }

    .header__cta {
      width: 100%;
      margin-top: var(--space-5);
    }
  }
</style>
