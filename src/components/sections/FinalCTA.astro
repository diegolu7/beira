---
import { site } from '../../data/site';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
---

<section class="final-cta">
  <div class="container">
    <div class="final-cta__inner" data-reveal>
      <p class="final-cta__eyebrow">¿Listo para empezar?</p>
      <h2>Demos el próximo paso juntos</h2>
      <p class="final-cta__desc">
        Contanos qué necesitás y te ayudamos a definir el mejor camino para tu proyecto. Una
        conversación no cuesta nada.
      </p>
      <div class="final-cta__actions">
        <WhatsAppButton variant="dark" location="final-cta" label="Conversar por WhatsApp" />
        <a href={`mailto:${site.contact.email}`} class="btn btn--secondary btn--lg">
          {site.contact.email}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background: var(--color-surface);
    padding-block: var(--section-pad);
  }

  .final-cta__inner {
    max-width: 900px;
    margin-inline: auto;
    text-align: center;
    background: var(--color-accent);
    border-radius: var(--radius-image);
    padding: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 5vw, 4rem);
  }

  .final-cta__eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    opacity: 0.7;
  }

  .final-cta h2 {
    margin-top: var(--space-4);
    color: var(--color-ink);
  }

  .final-cta__desc {
    margin-top: var(--space-4);
    color: var(--color-ink);
    font-size: var(--text-md);
    max-width: 560px;
    margin-inline: auto;
  }

  .final-cta__actions {
    margin-top: var(--space-7);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }
</style>
