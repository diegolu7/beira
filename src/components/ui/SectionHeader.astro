---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  id?: string;
}

const { eyebrow, title, description, align = 'left', id } = Astro.props;
const classes = ['section-header', align === 'center' ? 'section-header--center' : ''];
---

<div id={id} class:list={classes} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {description && <p class="section-header__desc">{description}</p>}
</div>
